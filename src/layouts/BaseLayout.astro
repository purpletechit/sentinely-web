---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import BrandmarkSprite from '../components/BrandmarkSprite.astro';
import { localizePath, stripLocale, useTranslations, type Lang } from '../i18n/utils';
import { SITE_ORIGIN, OG_IMAGE } from '../config';

interface Props {
  title: string;
  description: string;
  image?: string;
  /**
   * Real pixel size of `image`, when it is not the site default. Sharing
   * previews render sooner when the dimensions are declared — but only true
   * ones: the default 1200×630 would be a lie for an article cover.
   */
  imageSize?: { width: number; height: number };
  noindex?: boolean;
  /**
   * Explicit language alternates, as ready-made paths per language.
   *
   * Left out, the layout assumes every page exists at the same logical path in
   * both languages — true for the hand-built pages, false for the blog, where a
   * post may be published in one language only or under a different slug, and
   * where the two listings can run to a different number of pages. Pages that
   * know better pass the real set; anything absent gets no hreflang rather than
   * one pointing at a 404.
   */
  alternates?: Partial<Record<Lang, string>>;
  /** Structured data. Emitted verbatim as application/ld+json. */
  jsonLd?: unknown;
  ogType?: 'website' | 'article';
  /** Article-level Open Graph, for post pages. */
  article?: {
    publishedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  /** Feed to advertise in the head, e.g. the blog RSS for this language. */
  feed?: { href: string; title: string };
  /**
   * Where the header's language switch should go, when that is not the same
   * question as `alternates`. A post published in English only has no Italian
   * hreflang — but the IT button still has to lead somewhere real, so the page
   * points it at the Italian blog index.
   */
  switchTo?: Partial<Record<Lang, string>>;
}

const {
  title,
  description,
  image = OG_IMAGE,
  imageSize,
  noindex = false,
  alternates,
  jsonLd,
  ogType = 'website',
  article,
  feed,
  switchTo,
} = Astro.props;

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);

const site = Astro.site ?? new URL(SITE_ORIGIN);
// Derive URLs from the logical (locale-stripped) path so canonical + hreflang
// always match the trailing-slash form Cloudflare Pages serves.
const logicalPath = stripLocale(Astro.url.pathname);

const canonicalURL = new URL(alternates?.[lang] ?? localizePath(logicalPath, lang), site);

// One entry per language that really has this page. x-default points at
// English when it exists, otherwise at the only version there is.
const alternateURLs = (['en', 'it'] as Lang[])
  .map((code) => {
    const path = alternates ? alternates[code] : localizePath(logicalPath, code);
    return path ? { code, href: new URL(path, site).href } : null;
  })
  .filter((entry): entry is { code: Lang; href: string } => entry !== null);

const xDefaultURL = (alternateURLs.find((entry) => entry.code === 'en') ?? alternateURLs[0])?.href;

const ogImageURL = new URL(image, site);
// The site OG image is a known 1200×630; anything else has to declare itself.
const ogImageSize = imageSize ?? (image === OG_IMAGE ? { width: 1200, height: 630 } : undefined);

const ogLocale = lang === 'it' ? 'it_IT' : 'en_US';
const ogLocaleAlt = lang === 'it' ? 'en_US' : 'it_IT';
const hasAlternateLocale = alternateURLs.some((entry) => entry.code !== lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Language alternates -->
    {alternateURLs.map((entry) => <link rel="alternate" hreflang={entry.code} href={entry.href} />)}
    {xDefaultURL && <link rel="alternate" hreflang="x-default" href={xDefaultURL} />}

    {feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    {ogImageSize && <meta property="og:image:width" content={String(ogImageSize.width)} />}
    {ogImageSize && <meta property="og:image:height" content={String(ogImageSize.height)} />}
    <meta property="og:locale" content={ogLocale} />
    {hasAlternateLocale && <meta property="og:locale:alternate" content={ogLocaleAlt} />}

    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Icons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f5f2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131009" />
    <meta name="generator" content={Astro.generator} />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
        />
      )
    }

    <!-- Before first paint: mark JS on (gates the reveal animation so no-JS
         visitors always see content) and apply the stored theme (no FOUC). -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <BrandmarkSprite />
    <a href="#main" class="skip-link">{t('common.skipToContent')}</a>
    <Header langTargets={switchTo ?? alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />

    <style>
      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 100;
        transform: translateY(-150%);
        background-color: var(--accent-solid);
        color: var(--btn-fg);
        font-weight: 600;
        font-size: 0.9rem;
        padding: 0.6rem 0.9rem;
        border-radius: var(--radius-sm);
        transition: transform 0.16s ease;
      }
      .skip-link:focus {
        transform: translateY(0);
      }
      #main {
        display: block;
      }
    </style>

    <script>
      // Theme toggle — delegated so it works for every [data-theme-toggle] button.
      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const btn = target.closest('[data-theme-toggle]');
        if (!btn) return;
        const root = document.documentElement;
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const current = root.getAttribute('data-theme') || (prefersDark ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch (e) {
          /* storage unavailable — theme still applies for the session */
        }
      });

      // Reveal-on-scroll — subtle, and skipped for reduced-motion users.
      const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reveal = (el: Element) => el.classList.add('is-visible');
      if (reduce || !('IntersectionObserver' in window)) {
        revealEls.forEach(reveal);
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                reveal(entry.target);
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 },
        );
        revealEls.forEach((el) => io.observe(el));

        // Reveal above-the-fold content right after first paint (protects LCP and
        // guarantees visibility even if the observer's first callback is delayed).
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            revealEls.forEach((el) => {
              const r = el.getBoundingClientRect();
              if (r.top < window.innerHeight && r.bottom > 0) reveal(el);
            });
          }),
        );
      }
    </script>
  </body>
</html>
