---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SolutionBody from '../../../components/pages/SolutionBody.astro';
import { useTranslations, type Lang } from '../../../i18n/utils';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
---

<BaseLayout
  title={t('solutions.marketing.meta.title')}
  description={t('solutions.marketing.meta.description')}
>
  <SolutionBody segment="marketing" />
</BaseLayout>
