---
/**
 * The API's own `notes[]`, shared by both DNS tools.
 *
 * ⚠️ Titles and details arrive already localised and are printed verbatim.
 * Rewording them here would put two authorities on the page saying slightly
 * different things — and the API is the one that knows why it said it.
 *
 * The severity chip follows the API's severity and nothing else. In particular
 * a DNS that would not answer is filed as `warning`, never `critical`: not
 * being able to read a record is not the same as the record being wrong, and
 * the page must not upgrade the verdict on its own.
 */
interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<section class="tn" data-tool-notes-section hidden>
  <h2 class="tn-heading">{heading}</h2>
  <ul class="tn-list" data-tool-notes></ul>

  <template data-tpl-note>
    <li class="tn-note">
      <span class="chip chip-xs" data-sev></span>
      <div class="tn-body">
        <p class="tn-title" data-title></p>
        <p class="tn-detail" data-detail></p>
      </div>
    </li>
  </template>
</section>

<style>
  [hidden] {
    display: none !important;
  }

  .tn-heading {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--strong);
    letter-spacing: -0.01em;
  }
  .tn-list {
    margin-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .tn-note {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background-color: var(--surface);
  }
  .tn-note .chip {
    flex: none;
    margin-top: 0.1rem;
  }
  .tn-title {
    font-weight: 660;
    color: var(--strong);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .tn-detail {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.65;
    max-width: 76ch;
  }

  .chip-xs {
    font-size: 0.68rem;
    padding: 0.2rem 0.45rem;
  }
  .chip-muted {
    color: var(--muted);
  }
</style>
