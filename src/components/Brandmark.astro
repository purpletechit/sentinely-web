---
// The Sentinely shield, inline so it inherits colour from the text beside it.
//
// Sized in `em` off the wordmark at twice its cap height, so it stands exactly
// as tall as two stacked S's. Being taller than the line of text, it is centred
// on the wordmark rather than set on the baseline (see .brand in Header/Footer,
// which sets align-items: center) — a mark this size left on the baseline would
// hang entirely above the word. Behind it sits the radial halo that replaced
// the old CSS beacon — same 2.6s / same easing, so the pulse still reads as the
// same signal, and sized off --brandmark-size so it grows with the mark.
//
// aria-hidden: the accessible name lives on the .brand link, and the word
// "Sentinely" is written right next to it. Announcing the mark too would say
// the name twice.
//
// The geometry itself comes from the <symbol> that <BrandmarkSprite /> puts on
// the page — see BaseLayout.
import { markFull, markSimple } from '../data/brandmark.js';

interface Props {
  /**
   * `simple` drops the eye counters and fattens the strokes — required below
   * ~20px tall. At the doubled size the header and footer now draw it at ~26px,
   * which is above the threshold where `full` holds together: worth a look if
   * the fattened strokes start reading as heavy.
   */
  variant?: 'simple' | 'full';
  /**
   * Height of the mark. Keep it in `em` so it tracks the wordmark — the
   * default is twice the measured cap height of this font stack (S = 0.725em,
   * not the 1em of the font size). Width follows from the variant's ratio, so
   * overriding this never distorts the drawing.
   */
  size?: string;
  class?: string;
}

const { variant = 'simple', size = '1.45em', class: className } = Astro.props;
const mark = variant === 'simple' ? markSimple : markFull;
---

<span
  class:list={['brandmark', className]}
  style={`--brandmark-size:${size};--brandmark-ratio:${mark.ratio.toFixed(5)}`}
  aria-hidden="true"
>
  <svg class="brandmark-art" focusable="false">
    <use href={`#${mark.id}`} />
  </svg>
</span>

<style>
  /* currentColor, so a caller can recolour it by setting `color` — but the
     accent is the default, carrying over the beacon this mark replaces. */
  .brandmark {
    position: relative;
    display: inline-flex;
    flex: none;
    color: var(--accent-solid);
    /* Optical correction on top of the flex centring. Centring lines the mark
       up with the middle of the wordmark's *line box*, which for this stack
       sits 0.393em above the baseline; the middle of the cap band — baseline
       to 0.725em, the mass the eye actually reads — sits at 0.363em. The nudge
       closes those 0.03em. In `em` off the wordmark, not off --brandmark-size,
       because it answers to the type, not to how big the mark is. A transform
       so it stays out of layout: nothing in the header shifts. */
    transform: translateY(0.03em);
  }

  /* Positioned (not z-indexed) so it paints above the halo purely by document
     order — a negative z-index would slip behind the footer's background. */
  .brandmark-art {
    position: relative;
    display: block;
    height: var(--brandmark-size);
    width: calc(var(--brandmark-size) * var(--brandmark-ratio));
  }

  /* The old beacon's ping, minus the ring: a soft radial breath behind a solid
     shape. Same duration and easing as .beacon so both belong to one family. */
  .brandmark::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--brandmark-size) * 1.75);
    height: calc(var(--brandmark-size) * 1.75);
    margin-left: calc(var(--brandmark-size) * -0.875);
    margin-top: calc(var(--brandmark-size) * -0.875);
    border-radius: 999px;
    background: radial-gradient(
      circle closest-side,
      color-mix(in srgb, var(--accent-solid) 55%, transparent),
      transparent
    );
    animation: brandmark-halo 2.6s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes brandmark-halo {
    0% {
      transform: scale(0.5);
      opacity: 0.45;
    }
    70%,
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brandmark::before {
      animation: none;
      opacity: 0;
    }
  }
</style>
