---
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';
import Brandmark from './Brandmark.astro';
import { localizePath, useTranslations, type Lang } from '../i18n/utils';
import { segments } from '../data/segments';
import { APP_LOGIN_URL, APP_SIGNUP_URL } from '../config';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
const homeHref = localizePath('/', lang);

const nav = [
  { href: `${homeHref}#features`, label: t('nav.features') },
  { href: `${homeHref}#how`, label: t('nav.how') },
  { href: `${homeHref}#pricing`, label: t('nav.pricing') },
  { href: `${homeHref}#faq`, label: t('nav.faq') },
  { href: localizePath('/contact', lang), label: t('nav.contact') },
];

const solutions = segments.map((segment) => ({
  href: localizePath(segment.path, lang),
  label: t(`solutions.${segment.id}.nav`) as string,
  hint: t(`solutions.${segment.id}.navHint`) as string,
}));
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a href={homeHref} class="brand" aria-label={t('site.name')}>
      <Brandmark />
      <span class="brand-name">{t('site.name')}</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <div class="nav-group" data-nav-group>
        <button
          type="button"
          class="nav-link nav-trigger"
          id="solutions-trigger"
          aria-expanded="false"
          aria-controls="solutions-menu"
          data-nav-trigger
        >
          {t('nav.solutions')}
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" aria-hidden="true">
            <path d="m6 9.5 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <div class="nav-panel" id="solutions-menu" aria-labelledby="solutions-trigger" data-nav-panel>
          <p class="nav-panel-hint">{t('solutions.menuHint')}</p>
          {solutions.map((item) => (
            <a href={item.href} class="nav-panel-item">
              <span class="npi-label">{item.label}</span>
              <span class="npi-hint">{item.hint}</span>
            </a>
          ))}
        </div>
      </div>
      {nav.map((item) => <a href={item.href} class="nav-link">{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <LangSwitch />
      <ThemeToggle />
      <a href={APP_LOGIN_URL} class="btn btn-ghost btn-sm">{t('cta.login')}</a>
      <a href={APP_SIGNUP_URL} class="btn btn-primary btn-sm">{t('cta.startTrial')}</a>
    </div>

    <div class="header-mobile">
      <ThemeToggle />
      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('common.openMenu')}
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
          <path class="line-top" d="M4 7h16" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
          <path class="line-mid" d="M4 12h16" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
          <path class="line-bot" d="M4 17h16" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="mobile-nav" aria-label="Mobile">
      <p class="mobile-group-label label">{t('nav.solutions')}</p>
      {solutions.map((item) => (
        <a href={item.href} class="mobile-link is-nested">{item.label}</a>
      ))}
      {nav.map((item) => <a href={item.href} class="mobile-link">{item.label}</a>)}
    </nav>
    <div class="mobile-cta">
      <a href={APP_LOGIN_URL} class="btn btn-ghost btn-block">{t('cta.login')}</a>
      <a href={APP_SIGNUP_URL} class="btn btn-primary btn-block">{t('cta.startTrial')}</a>
    </div>
    <div class="mobile-lang">
      <LangSwitch />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--line);
    background-color: color-mix(in srgb, var(--bg) 90%, transparent);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 4rem;
  }

  /* Baseline, not centre: the mark stands on the same line as the S. */
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.42rem;
    font-weight: 750;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
    color: var(--strong);
    margin-right: auto;
  }
  .brand-name {
    line-height: 1;
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: 0.35rem;
  }
  .nav-link {
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 550;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-sm);
    transition: color 0.14s ease, background-color 0.14s ease;
  }
  .nav-link:hover {
    color: var(--strong);
    background-color: var(--surface-2);
  }

  /* ---- Solutions dropdown ---- */
  .nav-group {
    position: relative;
  }
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--sans);
    font-size: 0.92rem;
    font-weight: 550;
  }
  .nav-trigger svg {
    transition: transform 0.16s ease;
  }
  .nav-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    width: 22rem;
    max-width: calc(100vw - 2rem);
    padding: 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background-color: var(--surface);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.4rem);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
  }
  /* Hover opens it for pointers; keyboard and click go through [data-open],
     which the script owns — see the dropdown block in <script> below. */
  .nav-group:hover .nav-panel,
  .nav-group[data-open] .nav-panel {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .nav-group:hover .nav-trigger svg,
  .nav-group[data-open] .nav-trigger svg {
    transform: rotate(180deg);
  }
  .nav-panel-hint {
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.62rem;
    font-weight: 600;
    color: var(--faint);
    padding: 0.3rem 0.6rem 0.55rem;
  }
  .nav-panel-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.14s ease;
  }
  .nav-panel-item:hover {
    background-color: var(--surface-2);
  }
  .npi-label {
    font-size: 0.92rem;
    font-weight: 650;
    color: var(--strong);
  }
  .npi-hint {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .header-actions {
    display: none;
    align-items: center;
    gap: 0.6rem;
  }
  .header-mobile {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-sm {
    padding: 0.5rem 0.85rem;
    font-size: 0.88rem;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background-color: transparent;
    color: var(--strong);
    cursor: pointer;
  }
  .menu-toggle:hover {
    border-color: var(--accent-solid);
    color: var(--accent);
  }

  .mobile-menu {
    border-top: 1px solid var(--line);
    background-color: var(--bg);
    padding: 1rem 1.25rem 1.5rem;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-nav {
    display: flex;
    flex-direction: column;
  }
  .mobile-link {
    padding: 0.85rem 0.25rem;
    font-size: 1rem;
    font-weight: 550;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .mobile-link:hover {
    color: var(--accent);
  }
  .mobile-group-label {
    padding: 0.9rem 0.25rem 0.45rem;
  }
  .mobile-link.is-nested {
    padding-left: 0.9rem;
    font-weight: 500;
    color: var(--muted);
  }
  .mobile-cta {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }
  .mobile-lang {
    margin-top: 1.1rem;
    display: flex;
    justify-content: center;
  }

  /* Animate hamburger → close */
  .site-header[data-open] .menu-toggle .line-top {
    transform: translateY(5px) rotate(45deg);
  }
  .site-header[data-open] .menu-toggle .line-mid {
    opacity: 0;
  }
  .site-header[data-open] .menu-toggle .line-bot {
    transform: translateY(-5px) rotate(-45deg);
  }
  .menu-toggle svg path {
    transform-origin: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (min-width: 1024px) {
    .nav-desktop {
      display: flex;
    }
    .header-actions {
      display: flex;
    }
    .header-mobile {
      display: none;
    }
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = header.querySelector<HTMLElement>('#mobile-menu');

    const setOpen = (open: boolean) => {
      if (!toggle || !menu) return;
      if (open) {
        header.setAttribute('data-open', '');
        menu.hidden = false;
      } else {
        header.removeAttribute('data-open');
        menu.hidden = true;
      }
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle?.addEventListener('click', () => {
      setOpen(!header.hasAttribute('data-open'));
    });

    menu?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    // Solutions dropdown. CSS opens it on :hover for pointer users; [data-open]
    // covers click and keyboard. Tabbing in opens it, tabbing out closes it, so
    // the panel's links are reachable in order.
    const group = header.querySelector<HTMLElement>('[data-nav-group]');
    const trigger = group?.querySelector<HTMLButtonElement>('[data-nav-trigger]');

    const setGroupOpen = (open: boolean) => {
      if (!group || !trigger) return;
      group.toggleAttribute('data-open', open);
      trigger.setAttribute('aria-expanded', String(open));
    };

    trigger?.addEventListener('click', () => {
      setGroupOpen(!group?.hasAttribute('data-open'));
    });

    // Set while Escape moves focus back to the trigger, so that programmatic
    // refocus doesn't immediately reopen the panel it just closed.
    let ignoreFocusIn = false;

    group?.addEventListener('focusin', () => {
      if (!ignoreFocusIn) setGroupOpen(true);
    });
    group?.addEventListener('focusout', (e) => {
      if (!group.contains(e.relatedTarget as Node | null)) setGroupOpen(false);
    });

    document.addEventListener('click', (e) => {
      if (group && !group.contains(e.target as Node)) setGroupOpen(false);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      setOpen(false);
      if (group?.hasAttribute('data-open')) {
        ignoreFocusIn = true;
        setGroupOpen(false);
        trigger?.focus(); // fires focusin synchronously — guarded above
        ignoreFocusIn = false;
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) setOpen(false);
    });

    const onScroll = () => {
      if (window.scrollY > 4) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
