---
import { localizePath, useTranslations, type Lang } from '../i18n/utils';
import { segments } from '../data/segments';
import Brandmark from './Brandmark.astro';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
const homeHref = localizePath('/', lang);
const p = (path: string) => localizePath(path, lang);

const product = [
  { href: `${homeHref}#features`, label: t('footer.product.features') },
  { href: `${homeHref}#how`, label: t('footer.product.how') },
  { href: `${homeHref}#pricing`, label: t('footer.product.pricing') },
  { href: `${homeHref}#faq`, label: t('footer.product.faq') },
];

/**
 * The free tools, in a column of their own rather than as one line under
 * Product. There are three of them now, each its own entry point from search,
 * and a footer is where somebody who scrolled past the header goes looking.
 * Slugs stay English in both locales, like the segment pages.
 */
const tools = [
  { href: p('/tools/email-header-analyzer'), label: t('footer.tools.headerAnalyzer') },
  { href: p('/tools/dmarc-report-delivery'), label: t('footer.tools.dmarcDelivery') },
  { href: p('/tools/spf-surface'), label: t('footer.tools.spfSurface') },
];

const solutions = segments.map((segment) => ({
  href: p(segment.path),
  label: t(`solutions.${segment.id}.short`) as string,
}));
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={homeHref} class="brand" aria-label={t('site.name')}>
        <Brandmark />
        <span class="brand-name">{t('site.name')}</span>
      </a>
      <p class="footer-tagline measure">{t('footer.tagline')}</p>
    </div>

    <nav class="footer-col" aria-label={t('footer.colProduct')}>
      <h2 class="footer-heading">{t('footer.colProduct')}</h2>
      <ul>
        {product.map((item) => (
          <li><a href={item.href} class="footer-link">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label={t('footer.colTools')}>
      <h2 class="footer-heading">{t('footer.colTools')}</h2>
      <ul>
        {tools.map((item) => (
          <li><a href={item.href} class="footer-link">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label={t('footer.colSolutions')}>
      <h2 class="footer-heading">{t('footer.colSolutions')}</h2>
      <ul>
        {solutions.map((item) => (
          <li><a href={item.href} class="footer-link">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label={t('footer.colCompany')}>
      <h2 class="footer-heading">{t('footer.colCompany')}</h2>
      <ul>
        <li><a href={p('/about')} class="footer-link">{t('footer.company.about')}</a></li>
        <li><a href={p('/blog')} class="footer-link">{t('footer.company.blog')}</a></li>
        <li><a href={p('/affiliates')} class="footer-link">{t('footer.company.affiliates')}</a></li>
        <li><a href={p('/contact')} class="footer-link">{t('footer.company.contact')}</a></li>
      </ul>
    </nav>

    <nav class="footer-col" aria-label={t('footer.colLegal')}>
      <h2 class="footer-heading">{t('footer.colLegal')}</h2>
      <ul>
        <li><a href={p('/privacy')} class="footer-link">{t('footer.legal.privacy')}</a></li>
        <li><a href={p('/terms')} class="footer-link">{t('footer.legal.terms')}</a></li>
        <li><a href={p('/gdpr')} class="footer-link">{t('footer.legal.gdpr')}</a></li>
        <li><a href={p('/cookies')} class="footer-link">{t('footer.legal.cookies')}</a></li>
        <li hidden data-consent-preferences>
          <button type="button" class="footer-link footer-link-button">{t('footer.legal.preferences')}</button>
        </li>
      </ul>
    </nav>
  </div>

  <div class="container">
    <div class="footer-legal">
      <p>{t('footer.legalBar')}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background-color: var(--surface);
    padding-top: 3.5rem;
    margin-top: 1rem;
  }
  .footer-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    padding-bottom: 2.5rem;
  }
  /* Same lockup as the header — centred on the wordmark, same gap. The
     line-height matters here: centring is measured against the line box, so
     the footer has to set the header's 1 rather than inherit the body's. */
  .footer-brand .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 750;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
    color: var(--strong);
  }
  .footer-brand .brand-name {
    line-height: 1;
  }
  .footer-tagline {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 30ch;
  }
  .footer-heading {
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--faint);
    margin-bottom: 0.9rem;
  }
  /* min-width:0 so a long link wraps inside its column instead of widening the
     track and pushing the row past the container. */
  .footer-col {
    min-width: 0;
  }
  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .footer-link {
    color: var(--muted);
    font-size: 0.94rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.14s ease;
  }
  .footer-link:hover {
    color: var(--accent);
  }
  /* The cookie preferences entry point is a button, not a link: it opens a
     dialog rather than navigating. It has to look identical to its neighbours —
     withdrawal must be as easy to find as consent was to give. */
  .footer-link-button {
    font: inherit;
    font-size: 0.94rem;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }
  .footer-legal {
    border-top: 1px solid var(--line);
    padding-block: 1.5rem 2rem;
  }
  .footer-legal p {
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--faint);
    letter-spacing: 0.01em;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  /* Five columns need more room than four did, so the single row starts later
     than it used to. Below this the columns stay in the 640px arrangement,
     which simply takes a second line — better than five tracks too narrow to
     read. Even at 1100 the longest labels ("DMARC report delivery", "Recapito
     dei report DMARC") take two lines; fitting them on one would need a
     ~1350px viewport, which is not worth distorting the row for. */
  @media (min-width: 1100px) {
    .footer-grid {
      grid-template-columns: 1.5fr repeat(5, minmax(0, 1fr));
      gap: 2rem;
    }
    .footer-brand {
      grid-column: auto;
    }
  }
</style>
