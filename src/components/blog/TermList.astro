---
import { termPath, type TermEntry } from '../../lib/blog';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  label: string;
  terms: TermEntry[];
  /** Slug of the term whose page we are on, if any. */
  activeSlug?: string;
  /**
   * 'primary' is the same control one rung up: a slightly larger label and more
   * room around it. Categories take it because there are a handful of them and
   * they divide the blog, while the tags cut across it and are four times as
   * many. One step, not a second design — the two lists have to stay legible as
   * the same family of filter.
   */
  variant?: 'default' | 'primary';
}

const { lang, label, terms, activeSlug, variant = 'default' } = Astro.props;
const primary = variant === 'primary';
---

{
  terms.length > 0 && (
    <nav class:list={['term-list', { 'term-list--primary': primary }]} aria-label={label}>
      <span class="term-label">{label}</span>
      <ul>
        {terms.map((term) => (
          <li>
            <a
              href={termPath(lang, term.data.kind, term.data.slug)}
              class:list={[
                'term',
                { 'term--primary': primary, 'is-active': term.data.slug === activeSlug },
              ]}
              aria-current={term.data.slug === activeSlug ? 'page' : undefined}
            >
              {/* Already localised by the API. */}
              {term.data.name}
              <span class="term-count">{term.data.postCount}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .term-list {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }
  .term-label {
    color: var(--faint);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .term-list ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
  }
  .term {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background-color: var(--surface);
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 550;
    transition: border-color 0.16s ease, color 0.16s ease;
  }
  .term:hover {
    border-color: var(--accent-line);
    color: var(--accent);
  }
  .term.is-active {
    border-color: var(--accent-solid);
    background-color: var(--accent-soft);
    color: var(--accent);
  }
  .term-count {
    color: var(--faint);
    font-size: 0.75rem;
  }

  /* The primary rung. Only size and spacing change: same shape, same colours,
     same states, so the two lists still read as one set of controls. */
  .term-list--primary .term-label {
    color: var(--muted);
  }
  .term--primary {
    padding: 0.42rem 0.95rem;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .term--primary .term-count {
    font-size: 0.8rem;
  }
  .term.is-active .term-count {
    color: inherit;
  }
</style>
