---
import PostCard from './PostCard.astro';
import type { PostEntry } from '../../lib/blog';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  posts: PostEntry[];
  lang: Lang;
  /** Cards on page 1 lead the layout; the first one gets an eager cover. */
  firstPage?: boolean;
}

const { posts, lang, firstPage = true } = Astro.props;
const t = useTranslations(lang);
---

{
  posts.length === 0 ? (
    // Only reachable when the language really has no published posts. Every
    // other page in this section is generated from posts that exist.
    <div class="blog-empty">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6" />
        <path
          d="M3.5 7 12 13l8.5-6"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <p>{t('blog.empty')}</p>
    </div>
  ) : (
    <div class="post-grid">
      {posts.map((post, index) => (
        <PostCard post={post} eager={firstPage && index === 0} />
      ))}
    </div>
  )
}

<style>
  .blog-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    padding: 4rem 1.5rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius-lg);
    background-color: var(--surface);
    color: var(--muted);
  }
  .blog-empty svg {
    color: var(--faint);
  }
  .blog-empty p {
    max-width: 40ch;
    font-size: 1rem;
  }
  .post-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .post-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
