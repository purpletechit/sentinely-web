---
import { interpolate, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  current: number;
  total: number;
  /** Builds the href for a page number. */
  href: (page: number) => string;
}

const { lang, current, total, href } = Astro.props;
const t = useTranslations(lang);

// Numbers worth rendering: the ends, and a window around the current page.
const numbers = Array.from({ length: total }, (_unused, index) => index + 1).filter(
  (page) => page === 1 || page === total || Math.abs(page - current) <= 1,
);
---

{
  total > 1 && (
    <nav class="pagination" aria-label={t('blog.pagination.label')}>
      {current > 1 ? (
        <a class="page-step" href={href(current - 1)} rel="prev">
          ← {t('blog.pagination.prev')}
        </a>
      ) : (
        <span class="page-step is-off">← {t('blog.pagination.prev')}</span>
      )}

      <ol class="page-numbers">
        {numbers.map((page, index) => (
          <>
            {index > 0 && numbers[index - 1]! < page - 1 && <li class="page-gap">…</li>}
            <li>
              {page === current ? (
                <span class="page-number is-current" aria-current="page">
                  {page}
                </span>
              ) : (
                <a class="page-number" href={href(page)}>
                  {page}
                </a>
              )}
            </li>
          </>
        ))}
      </ol>

      {current < total ? (
        <a class="page-step" href={href(current + 1)} rel="next">
          {t('blog.pagination.next')} →
        </a>
      ) : (
        <span class="page-step is-off">{t('blog.pagination.next')} →</span>
      )}

      <p class="page-status">{interpolate(t('blog.pagination.status'), { current, total })}</p>
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 2.5rem;
  }
  .page-step {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
  }
  .page-step.is-off {
    color: var(--faint);
    opacity: 0.6;
  }
  .page-numbers {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
  }
  .page-gap {
    color: var(--faint);
    padding: 0 0.15rem;
  }
  .page-number {
    display: grid;
    place-items: center;
    min-width: 2.1rem;
    height: 2.1rem;
    padding: 0 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
  }
  a.page-number:hover {
    border-color: var(--accent-line);
    color: var(--accent);
  }
  .page-number.is-current {
    border-color: var(--accent-solid);
    background-color: var(--accent-soft);
    color: var(--accent);
  }
  /* Announced by screen readers, invisible on screen: the numbers alone do not
     say where you are in the sequence. */
  .page-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
